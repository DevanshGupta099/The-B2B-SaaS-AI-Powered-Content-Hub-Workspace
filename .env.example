# ==============================================================================
# NEXUS B2B SAAS AI CONTENT OS & WORKSPACE - ENVIRONMENT TEMPLATE
# ==============================================================================

# LLM Provider Configuration ("groq", "gemini", "openrouter", or "ollama")
LLM_PROVIDER="groq"
LLM_MODEL="qwen/qwen3.8-27b"
GROQ_API_KEY="your_groq_api_key_here"
GEMINI_API_KEY="your_gemini_api_key_here"
OPENROUTER_API_KEY="your_openrouter_api_key_here"

# Dense Embeddings Provider ("huggingface" or "ollama")
EMBEDDING_PROVIDER="huggingface"
EMBEDDING_MODEL="BAAI/bge-small-en-v1.5"
HUGGINGFACE_API_KEY="your_huggingface_api_key_here"

# Local Ollama Fallback Configuration (Optional)
OLLAMA_URL="http://localhost:11434"
OLLAMA_LLM_MODEL="llama3.2:3b"
OLLAMA_EMBEDDING_MODEL="nomic-embed-text"

# Deployment & Public Site URL
NEXT_PUBLIC_SITE_URL="https://nexus-content-hub.vercel.app"
